{
  "id": "through_filter_generic",
  "label": "Filter - Generic",
  "category": "junction",
  "topology": "through",
  "family": [
    "through.straight.filter"
  ],
  "profiles": [
    "Circular",
    "Rectangular",
    "Oval"
  ],
  "selection": {
    "kind": "inline",
    "priority": 50
  },
  "constraints": {
    "degree": 2
  },
  "properties": [
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Sheet metal thickness. 0 builds the air space as a solid body instead of a hollow shell",
      "default": 0.8,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "InsulationThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Insulation thickness wrapped around the outside of the fitting; 0 disables insulation",
      "default": 0.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "LinerThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Acoustic liner thickness inside the fitting wall; the sizes given are the clear airway inside the liner; 0 disables the liner",
      "default": 0.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "BoxLength",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Casing length along the duct. 0 uses twice the duct size",
      "default": 0.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "BoxWidth",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Casing width. 0 uses 1.5 times the duct size",
      "default": 0.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "BoxHeight",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Casing height. 0 uses 1.5 times the duct size",
      "default": 0.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "CollarLength",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Length of the inlet and outlet collars. 0 uses a quarter of the duct size",
      "default": 0.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "CleanPressureDrop",
      "prop_type": "App::PropertyFloat",
      "group": "Parameters",
      "description": "Pressure drop in Pa of a clean filter at the design flow (a typical value: replace with the maker's data)",
      "default": 80.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "FinalPressureDrop",
      "prop_type": "App::PropertyFloat",
      "group": "Parameters",
      "description": "Pressure drop in Pa at which the filter is changed (a typical value: replace with the maker's data)",
      "default": 250.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "FilterCondition",
      "prop_type": "App::PropertyEnumeration",
      "group": "Parameters",
      "description": "Which pressure drop the analysis uses: clean, final, or halfway between them (mid-life)",
      "default": "Mid-life",
      "validation": {
        "enum": [
          "Clean",
          "Mid-life",
          "Final"
        ]
      }
    },
    {
      "name": "FlangeHeight",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Height of the transverse flange at each duct connection",
      "default": 25.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "FlangeThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Thickness of the transverse flange; 0 draws no flanges",
      "default": 1.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "ShowFlange1",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at port 1",
      "default": true
    },
    {
      "name": "ShowFlange2",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at port 2",
      "default": true
    }
  ],
  "construction": {
    "layers": [
      {
        "id": "liner",
        "roles": [
          "flow_surface",
          "acoustic_absorber"
        ],
        "default_material_role": "acoustic_absorber",
        "thickness_property": "LinerThickness"
      },
      {
        "id": "casing",
        "roles": [
          "flow_surface",
          "structural_shell"
        ],
        "default_material_role": "structural_shell",
        "thickness_property": "Thickness"
      },
      {
        "id": "insulation",
        "roles": [
          "thermal_insulation"
        ],
        "default_material_role": "thermal_insulation",
        "thickness_property": "InsulationThickness"
      }
    ],
    "features": [
      {
        "id": "transverse_flange",
        "role": "transverse_joint",
        "host_layer": "casing",
        "module": "shared:features",
        "generator": "transverse_flange",
        "parameters": [
          "FlangeHeight",
          "FlangeThickness",
          "ShowFlange1",
          "ShowFlange2"
        ]
      },
      {
        "id": "filter_media",
        "role": "filter_media",
        "host_layer": "casing",
        "module": "shared:details",
        "generator": "filter_media",
        "parameters": [
          "BoxLength",
          "BoxWidth",
          "BoxHeight",
          "CollarLength"
        ]
      }
    ]
  },
  "geometry": {
    "backend": "generator",
    "module": "shared:inline",
    "function": "build_vav_box"
  },
  "connection_lengths": {
    "module": "shared:inline",
    "function": "measure_vav_box"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_inline_device"
  }
}
