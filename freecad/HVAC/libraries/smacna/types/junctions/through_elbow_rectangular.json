{
  "id": "through_elbow_rectangular",
  "label": "Elbow - Rectangular",
  "category": "junction",
  "topology": "through",
  "family": [
    "through.bend",
    "through.bend.3d",
    "through.bend_90",
    "through.bend_90.3d"
  ],
  "profiles": [
    "Rectangular"
  ],
  "selection": {
    "kind": "model",
    "priority": 45
  },
  "constraints": {
    "degree": 2
  },
  "properties": [
    {
      "name": "CenterlineRadius",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Elbow centerline radius",
      "default": 300.0
    },
    {
      "name": "SplitterVanes",
      "prop_type": "App::PropertyInteger",
      "group": "Parameters",
      "description": "Number of splitter vanes in the elbow, 0 to 3. Drawn as a feature",
      "default": 0,
      "validation": {
        "minimum": 0,
        "maximum": 3
      }
    },
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Sheet metal thickness",
      "default": 0.8
    },
    {
      "name": "FlangeHeight",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Flange height",
      "default": 25.0
    },
    {
      "name": "FlangeThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Flange thickness",
      "default": 1.0
    },
    {
      "name": "ShowFlange1",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at port 1",
      "default": true
    },
    {
      "name": "ShowFlange2",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at port 2",
      "default": true
    },
    {
      "name": "InsulationThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Insulation thickness wrapped around the outside of the elbow; 0 disables insulation",
      "default": 0.0
    }
  ],
  "construction": {
    "layers": [
      {
        "id": "casing",
        "roles": [
          "flow_surface",
          "structural_shell"
        ],
        "default_material_role": "structural_shell",
        "thickness_property": "Thickness"
      },
      {
        "id": "insulation",
        "roles": [
          "thermal_insulation"
        ],
        "default_material_role": "thermal_insulation",
        "thickness_property": "InsulationThickness"
      }
    ],
    "features": [
      {
        "id": "transverse_flange",
        "role": "transverse_joint",
        "host_layer": "casing",
        "module": "shared:features",
        "generator": "transverse_flange",
        "parameters": [
          "FlangeHeight",
          "FlangeThickness",
          "ShowFlange1",
          "ShowFlange2"
        ]
      },
      {
        "id": "splitter_vanes",
        "role": "splitter_vane",
        "host_layer": "casing",
        "module": "shared:details",
        "generator": "splitter_vanes",
        "parameters": [
          "CenterlineRadius",
          "SplitterVanes"
        ]
      }
    ]
  },
  "geometry": {
    "backend": "partscript",
    "file": "models/through_elbow_rectangular.py"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_elbow_generic"
  }
}
