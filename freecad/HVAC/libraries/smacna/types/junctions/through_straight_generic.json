{
  "id": "through_straight_generic",
  "label": "Straight - Generic",
  "category": "junction",
  "topology": "through",
  "family": [
    "through.straight"
  ],
  "profiles": [
    "Circular",
    "Rectangular",
    "Oval"
  ],
  "selection": {
    "kind": "model",
    "priority": 60
  },
  "constraints": {
    "degree": 2
  },
  "properties": [
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Sheet metal thickness",
      "default": 0.8
    },
    {
      "name": "Length",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Straight coupling length (no special fitting accessory)",
      "default": 5.0
    },
    {
      "name": "FlangeHeight",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Flange height",
      "default": 25.0
    },
    {
      "name": "FlangeThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Flange thickness",
      "default": 1.0
    },
    {
      "name": "ShowFlange1",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at port 1",
      "default": true
    },
    {
      "name": "ShowFlange2",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at port 2",
      "default": true
    },
    {
      "name": "InsulationThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Insulation thickness wrapped around the outside of the elbow; 0 disables insulation",
      "default": 0.0
    },
    {
      "name": "LinerThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Acoustic liner thickness inside the fitting wall; the sizes given are the clear airway inside the liner; 0 disables the liner",
      "default": 0.0
    }
  ],
  "geometry": {
    "backend": "generator",
    "module": "shared:through",
    "function": "build_straight"
  },
  "connection_lengths": {
    "module": "shared:through",
    "function": "measure_straight"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_transition_generic"
  },
  "construction": {
    "layers": [
      {
        "id": "liner",
        "roles": [
          "flow_surface",
          "acoustic_absorber"
        ],
        "default_material_role": "acoustic_absorber",
        "thickness_property": "LinerThickness"
      },
      {
        "id": "casing",
        "roles": [
          "flow_surface",
          "structural_shell"
        ],
        "default_material_role": "structural_shell",
        "thickness_property": "Thickness"
      },
      {
        "id": "insulation",
        "roles": [
          "thermal_insulation"
        ],
        "default_material_role": "thermal_insulation",
        "thickness_property": "InsulationThickness"
      }
    ],
    "features": [
      {
        "id": "transverse_flange",
        "role": "transverse_joint",
        "host_layer": "casing",
        "module": "shared:features",
        "generator": "transverse_flange",
        "parameters": [
          "FlangeHeight",
          "FlangeThickness",
          "ShowFlange1",
          "ShowFlange2"
        ]
      }
    ]
  }
}
