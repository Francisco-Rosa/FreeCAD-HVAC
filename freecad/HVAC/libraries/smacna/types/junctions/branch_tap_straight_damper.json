{
  "id": "branch_tap_straight_damper",
  "label": "Tap - Straight, with Damper",
  "description": "SMACNA 14-14 R: rectangular main and branch, with a damper in the branch (the damper is drawn as a feature). A manual choice: never selected automatically.",
  "category": "junction",
  "topology": "branch",
  "family": [
    "branch.tee.damper",
    "branch.tee.3d.damper"
  ],
  "profiles": [
    "Rectangular"
  ],
  "selection": {
    "kind": "model",
    "priority": 50
  },
  "constraints": {
    "degree": 3
  },
  "properties": [
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Sheet metal thickness. 0 builds the air space as a solid body instead of a hollow shell",
      "default": 0.8,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "InsulationThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Insulation thickness wrapped around the outside of the fitting; 0 disables insulation",
      "default": 0.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "TapHeight",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Height of tap connector",
      "default": 75.0,
      "validation": {
        "minimum": 1.0
      }
    },
    {
      "name": "TrimRunA",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for run port A",
      "default": 60.0
    },
    {
      "name": "TrimRunB",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for run port B",
      "default": 60.0
    },
    {
      "name": "TrimBranch",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for the tap's own branch duct",
      "default": 80.0
    },
    {
      "name": "Attachment",
      "prop_type": "App::PropertyEnumeration",
      "group": "Options",
      "description": "How the branch joins the run. Side: through the side of the run. Face: the branch passes over or under the run, and joins it with a collar and a 90 degree elbow. Auto picks one from where the branch is drawn",
      "default": "Auto",
      "validation": {
        "enum": [
          "Auto",
          "Side",
          "Face"
        ]
      }
    },
    {
      "name": "ElbowRadius",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Centreline radius of the elbow of a face-mounted branch. 0 uses the branch size",
      "default": 0.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "CollarRoll",
      "prop_type": "App::PropertyAngle",
      "group": "Options",
      "description": "Face-mounted branch on a round run only: rolls the collar about the run towards the branch (SMACNA 'rolled 45 deg'); the elbow then turns that much less. 0 = collar straight up",
      "default": 0.0,
      "validation": {
        "minimum": 0.0,
        "maximum": 75.0
      }
    },
    {
      "name": "FlangeHeight",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Height of the transverse flange at each duct connection",
      "default": 25.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "FlangeThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Thickness of the transverse flange; 0 draws no flanges",
      "default": 1.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "ShowFlangeRunA",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at run port A",
      "default": true
    },
    {
      "name": "ShowFlangeRunB",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at run port B",
      "default": true
    },
    {
      "name": "ShowFlangeBranch",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at the branch",
      "default": true
    }
  ],
  "construction": {
    "layers": [
      {
        "id": "casing",
        "roles": [
          "flow_surface",
          "structural_shell"
        ],
        "default_material_role": "structural_shell",
        "thickness_property": "Thickness"
      },
      {
        "id": "insulation",
        "roles": [
          "thermal_insulation"
        ],
        "default_material_role": "thermal_insulation",
        "thickness_property": "InsulationThickness"
      }
    ],
    "features": [
      {
        "id": "transverse_flange",
        "role": "transverse_joint",
        "host_layer": "casing",
        "module": "shared:features",
        "generator": "transverse_flange",
        "parameters": [
          "FlangeHeight",
          "FlangeThickness",
          "ShowFlangeRunA",
          "ShowFlangeRunB",
          "ShowFlangeBranch"
        ]
      },
      {
        "id": "tap_damper",
        "role": "damper_blade",
        "host_layer": "casing",
        "module": "shared:details",
        "generator": "tap_damper",
        "parameters": [
          "TapHeight"
        ]
      }
    ]
  },
  "geometry": {
    "backend": "generator",
    "module": "shared:taps",
    "function": "build_tap_straight"
  },
  "connection_lengths": {
    "module": "shared:taps",
    "function": "measure_tap_straight"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_tee_damper",
    "variants": [
      {
        "constraints": {
          "flow_class": {
            "enum": [
              "diverging"
            ]
          },
          "qualifiers": {
            "common_leg": {
              "enum": [
                "branch"
              ]
            }
          }
        },
        "module": "shared:losses",
        "function": "loss_branch_diverging_branch"
      },
      {
        "constraints": {
          "flow_class": {
            "enum": [
              "converging"
            ]
          },
          "qualifiers": {
            "common_leg": {
              "enum": [
                "branch"
              ]
            }
          }
        },
        "module": "shared:losses",
        "function": "loss_branch_converging_branch"
      }
    ]
  }
}
