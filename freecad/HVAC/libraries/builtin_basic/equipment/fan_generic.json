      "type": "length",
      "default": 600.0,
      "min": 1.0
    },
    {
      "name": "CasingHeight",
      "label": "Casing height",
      "type": "length",
      "default": 600.0,
      "min": 1.0
    },
    {
      "name": "CollarLength",
      "label": "Collar length",
      "type": "length",
