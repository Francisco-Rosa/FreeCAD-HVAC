{
  "id": "rectangular_straight",
  "label": "Rectangular Straight",
  "category": "segment",
  "family": [
    "straight_segment"
  ],
  "profiles": [
    "Rectangular"
  ],
  "selection": {
    "kind": "model",
    "priority": 50
  },
  "properties": [
    {
      "name": "Width",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Clear-air duct width",
      "default": 100.0,
      "validation": {"exclusiveMinimum": 0.0}
    },
    {
      "name": "Height",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Clear-air duct height",
      "default": 100.0,
      "validation": {"exclusiveMinimum": 0.0}
    },
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Sheet metal thickness",
      "default": 0.8
    },
    {
      "name": "FlangeHeight",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Flange height",
      "default": 25.0
    },
    {
      "name": "FlangeThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Flange thickness",
      "default": 1.0
    },
    {
      "name": "ShowFlange1",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at port 1 (start)",
      "default": true
    },
    {
      "name": "ShowFlange2",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at port 2 (end)",
      "default": true
    }
  ],
  "geometry": {
    "backend": "generator",
    "module": "segments",
    "function": "build_rectangular_straight_fcstd"
  }
}
